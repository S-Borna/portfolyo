# Environment Variables
# Copy this file to .env.local and fill in your values

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (created in Stripe Dashboard)
STRIPE_PRICE_PUBLISH=price_...           # 349 SEK one-time publish
STRIPE_PRICE_CREDITS_3=price_...         # 3 credits for 69 SEK
STRIPE_PRICE_CREDITS_5=price_...         # 5 credits for 99 SEK
STRIPE_PRICE_CREDITS_10=price_...        # 10 credits for 179 SEK
