{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portfolyo",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolyo"
    }
  ],
  "routes": [
    { "pattern": "portfolyo.se", "custom_domain": true },
    { "pattern": "www.portfolyo.se", "custom_domain": true },
    { "pattern": "*.portfolyo.se/*", "zone_name": "portfolyo.se" }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://REDACTED-SUPABASE-URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "REDACTED-SUPABASE-ANON-KEY"
  }
}
